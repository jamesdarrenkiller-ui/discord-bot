DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_test_server_id

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/discordbot

# AI (keep the real key only in .env / hosting secrets)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Dashboard
DASHBOARD_PORT=3000
DASHBOARD_SECRET=replace_with_a_long_random_secret
